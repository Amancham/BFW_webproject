{# base.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="stylesheet" href="../assets/style.css">
    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
    {% endblock %}
</head>
<body>
    <header>
        {% block menu %}{% endblock %}
    </header>

    {% block error %}
    {% endblock %}

    {% block success %}
    {% endblock %}

    {% block body %}
    {% endblock %}
</body>
</html>