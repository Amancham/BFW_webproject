{# base.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css">
    <link rel="stylesheet" href="../assets/style.css">
    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
    {% endblock %}
</head>
<body>
    <header>
        <nav>
            <a href="index.php">Home</a>

            {% if loggedin is same as(TRUE) %}
                <a href="dashboard.php">Dashboard</a>

                    {% if isadmin is same as(TRUE) %}
                        <a href="index.php?do=admin_dash">Verwaltung</a>
                    {% endif %}

                <a href="index.php?do=logout">Abmelden</a>
            {% endif %}

            {% if loggedin is same as(FALSE) %}
                <a href="index.php?do=register">Registrieren</a>
                <a href="index.php?do=login">Einloggen</a>
            {% endif %}
        </nav>
    </header>

    <h2>{{ block('title') }}</h2>
    {% block body %}

    {% endblock %}
</body>
</html>