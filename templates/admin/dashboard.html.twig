{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard: Verwaltung{% endblock %}

{% block body %}

<div class="dash">
    <div class="item">
        <div class="header">Tags</div>
        <div class="content">
            <div><a href="index.php?do=admin_dash&add=tag">Neues Tag</a></div>
            <ul>
            {% for tag in tags %}
                <li>{{ tag.name }}</li>
            {% else %}
            Noch keine Tags vorhanden.
            {% endfor %}
            </ul>
        </div>
    </div>

    <div class="item">
        <div class="header">Übungen</div>
        <div class="content">
        <div><a href="add_exercise">Neue Aufgabe</a></div>

        </div>
    </div>

    <div class="item">
        <div class="header">Benutzer</div>
        <div class="content">
        <div><a href="index.php?do=admin_dash&add=useradmin">Benutzerverwaltung</a></div>
            <ul>
            {% for user in users %}
                <li>{{ user.username }}</li>
            {% else %}
            Noch keine Benutzer vorhanden.
            {% endfor %}
            </ul>
        </div>
    </div>
</div>
{% endblock %}